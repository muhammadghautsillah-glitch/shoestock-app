<%- include('../partials/start', { active: 'products' }) %>

<div class="judul-halaman">
  <h1><%= title %></h1>
  <p class="sub">Lengkapi data sepatu di bawah ini.</p>
</div>

<div class="kartu-form lebar">
  <% if (errors.length > 0) { %>
    <ul class="pesan-error">
      <% errors.forEach(function(e) { %><li><%= e %></li><% }); %>
    </ul>
  <% } %>

  <form method="POST" action="<%= action %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="field">
      <label for="name">Nama</label>
      <input type="text" id="name" name="name" value="<%= old.name || '' %>" maxlength="100" required>
    </div>

    <div class="grid-dua">
      <div class="field">
        <label for="brand">Merek</label>
        <input type="text" id="brand" name="brand" value="<%= old.brand || '' %>" maxlength="50" required>
      </div>
      <div class="field">
        <label for="category">Kategori</label>
        <input type="text" id="category" name="category" value="<%= old.category || '' %>" maxlength="50" required>
      </div>
    </div>

    <div class="grid-dua">
      <div class="field">
        <label for="size">Ukuran</label>
        <input type="text" id="size" name="size" value="<%= old.size || '' %>" maxlength="10" required>
      </div>
      <div class="field">
        <label for="color">Warna</label>
        <input type="text" id="color" name="color" value="<%= old.color || '' %>" maxlength="30" required>
      </div>
    </div>

    <div class="grid-dua">
      <div class="field">
        <label for="price">Harga (Rp)</label>
        <input type="number" id="price" name="price" step="0.01" min="0" value="<%= old.price || '' %>" required>
      </div>
      <div class="field">
        <label for="stock">Stok</label>
        <input type="number" id="stock" name="stock" min="0" value="<%= old.stock || '0' %>" required>
      </div>
    </div>

    <div class="aksi-form">
      <button type="submit" class="btn-aksen">Simpan</button>
      <a href="/products" class="btn btn-garis">Batal</a>
    </div>
  </form>
</div>

<%- include('../partials/end') %>