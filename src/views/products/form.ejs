<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <p><a href="/products">&larr; Data Sepatu</a></p>
  <h1><%= title %></h1>

  <% if (errors.length > 0) { %>
    <ul class="error">
      <% errors.forEach(function(e) { %><li><%= e %></li><% }); %>
    </ul>
  <% } %>

  <form method="POST" action="<%= action %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Nama</label><br>
    <input type="text" name="name" value="<%= old.name || '' %>" required><br><br>
    <label>Merek</label><br>
    <input type="text" name="brand" value="<%= old.brand || '' %>" required><br><br>
    <label>Kategori</label><br>
    <input type="text" name="category" value="<%= old.category || '' %>" required><br><br>
    <label>Ukuran</label><br>
    <input type="text" name="size" value="<%= old.size || '' %>" required><br><br>
    <label>Warna</label><br>
    <input type="text" name="color" value="<%= old.color || '' %>" required><br><br>
    <label>Harga</label><br>
    <input type="number" name="price" step="0.01" min="0" value="<%= old.price || '' %>" required><br><br>
    <label>Stok</label><br>
    <input type="number" name="stock" min="0" value="<%= old.stock || '0' %>" required><br><br>
    <button type="submit">Simpan</button>
  </form>
</body>
</html>