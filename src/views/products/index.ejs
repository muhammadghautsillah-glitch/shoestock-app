<%- include('../partials/start', { active: 'products' }) %>

<div class="bar-atas">
  <div class="judul-halaman">
    <h1>Data Sepatu</h1>
    <p class="sub">Kelola data sepatu, harga, dan stok.</p>
  </div>
  <a href="/products/new" class="btn">+ Tambah Sepatu</a>
</div>

<input type="search" id="cari" class="cari" placeholder="Cari nama, merek, atau kategori...">
<div class="tabel-bungkus">
  <% if (products.length === 0) { %>
    <p class="kosong">Belum ada data sepatu.</p>
  <% } else { %>
    <table class="tabel"data-cari>
      <thead>
        <tr>
          <th>Nama</th><th>Merek</th><th>Kategori</th><th>Ukuran</th><th>Warna</th>
          <th class="angka">Harga</th><th class="angka">Stok</th><th>Status</th><th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(function(p) { %>
          <% const status = p.stock === 0 ? ['Habis', 'badge-habis'] : (p.stock <= 5 ? ['Menipis', 'badge-tipis'] : ['Tersedia', 'badge-ok']); %>
          <tr>
            <td><%= p.name %></td>
            <td><%= p.brand %></td>
            <td><%= p.category %></td>
            <td><%= p.size %></td>
            <td><%= p.color %></td>
            <td class="angka">Rp <%= Number(p.price).toLocaleString('id-ID') %></td>
            <td class="angka"><%= p.stock %></td>
            <td><span class="badge <%= status[1] %>"><%= status[0] %></span></td>
            <td>
              <div class="aksi">
                <a href="/products/<%= p.id %>/edit" class="btn btn-kecil btn-garis">Ubah</a>
                <% if (user.role === 'admin') { %>
                  <form method="POST" action="/products/<%= p.id %>/delete" data-konfirmasi="Hapus sepatu ini?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-kecil btn-bahaya">Hapus</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/end') %>