<%- include('../partials/start', { active: 'reports' }) %>

<div class="bar-atas">
  <div class="judul-halaman">
    <h1>Laporan Stok</h1>
    <p class="sub">Ringkasan stok dan riwayat barang masuk/keluar.</p>
  </div>
  <a href="/reports/export.csv" class="btn">Unduh data sepatu (CSV)</a>
</div>

<div class="kartu-angka">
  <div class="angka-kartu">
    <span>Jenis sepatu</span>
    <strong><%= ringkasan.jumlah_produk %></strong>
  </div>
  <div class="angka-kartu aksen">
    <span>Total stok (pasang)</span>
    <strong><%= ringkasan.total_stok %></strong>
  </div>
  <div class="angka-kartu peringatan">
    <span>Stok menipis (1-<%= batas %>)</span>
    <strong><%= ringkasan.stok_menipis %></strong>
  </div>
  <div class="angka-kartu bahaya">
    <span>Stok habis</span>
    <strong><%= ringkasan.stok_habis %></strong>
  </div>
</div>

<div class="panel">
  <h2>Stok per Sepatu</h2>
  <% if (produk.length === 0) { %>
    <p class="kosong">Belum ada data sepatu.</p>
  <% } else { %>
    <% produk.forEach(function(p) { %>
      <div class="grafik-baris">
        <div class="grafik-label"><%= p.name %> (<%= p.size %>)</div>
        <div class="grafik-jalur">
          <div class="grafik-isi" style="width: <%= Math.round(p.stock / stokTertinggi * 100) %>%"></div>
        </div>
        <div class="grafik-nilai"><%= p.stock %></div>
      </div>
    <% }); %>
  <% } %>
</div>

<h2>Riwayat Stok Terakhir</h2>
<div class="tabel-bungkus">
  <% if (riwayat.length === 0) { %>
    <p class="kosong">Belum ada riwayat stok.</p>
  <% } else { %>
    <table class="tabel">
      <thead>
        <tr>
          <th>Waktu</th><th>Sepatu</th><th>Ukuran</th><th>Jenis</th>
          <th class="angka">Jumlah</th><th>Catatan</th><th>Oleh</th>
        </tr>
      </thead>
      <tbody>
        <% riwayat.forEach(function(r) { %>
          <tr>
            <td><%= new Date(r.created_at).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }) %></td>
            <td><%= r.name %></td>
            <td><%= r.size %></td>
            <td>
              <% if (r.type === 'in') { %>
                <span class="badge badge-ok">Masuk</span>
              <% } else { %>
                <span class="badge badge-habis">Keluar</span>
              <% } %>
            </td>
            <td class="angka"><%= r.quantity %></td>
            <td><%= r.note || '-' %></td>
            <td><%= r.username || '-' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/end') %>