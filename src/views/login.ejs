<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> - ShoeStock</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="auth-halaman">
  <div class="auth-kartu">
    <div class="auth-panel">
      <img src="/img/logo-sepatu.svg" alt="Logo ShoeStock" class="logo-img">
      <div class="brand">Shoe<span>Stock</span></div>
      <p>Kelola stok sepatu dengan mudah, rapi, dan aman.</p>
    </div>

    <div class="auth-form">
      <h1>Selamat Datang</h1>
      <p class="sub">Masuk untuk mengelola data sepatu dan stok.</p>

      <% if (error) { %>
        <p class="pesan-error"><%= error %></p>
      <% } %>

      <form method="POST" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="field">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" autocomplete="username" required>
        </div>

        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" autocomplete="current-password" required>
        </div>

        <button type="submit" class="btn-aksen">Masuk</button>
      </form>

      <p class="auth-pindah">Belum punya akun? <a href="/register">Daftar sekarang</a></p>
    </div>
  </div>
</body>
</html>