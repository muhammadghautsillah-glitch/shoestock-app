<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> - ShoeStock</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="auth-halaman">
  <div class="auth-kartu">
    <div class="auth-panel">
      <div class="brand">Shoe<span>Stock</span></div>
      <p>Buat akun untuk mulai mengelola stok sepatu.</p>
    </div>

    <div class="auth-form">
      <h1>Buat Akun</h1>
      <p class="sub">Isi data di bawah untuk mendaftar.</p>

      <% if (errors.length > 0) { %>
        <ul class="pesan-error">
          <% errors.forEach(function(e) { %>
            <li><%= e %></li>
          <% }); %>
        </ul>
      <% } %>

      <form method="POST" action="/register">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="field">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" value="<%= old.username || '' %>"
                 minlength="3" maxlength="30" pattern="[a-zA-Z0-9_]+" autocomplete="username" required>
          <small>3-30 karakter: huruf, angka, dan underscore (_).</small>
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= old.email || '' %>"
                 autocomplete="email" required>
          <small>Contoh: nama@gmail.com. Tidak ada email verifikasi.</small>
        </div>

        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password"
                 minlength="10" maxlength="72" autocomplete="new-password" required>
          <small>10-72 karakter, wajib ada huruf besar, huruf kecil, angka, dan simbol.</small>
        </div>

        <div class="field">
          <label for="confirmPassword">Konfirmasi Password</label>
          <input type="password" id="confirmPassword" name="confirmPassword"
                 autocomplete="new-password" required>
        </div>

        <button type="submit" class="btn-aksen">Daftar</button>
      </form>

      <p class="auth-pindah">Sudah punya akun? <a href="/login">Masuk</a></p>
    </div>
  </div>
</body>
</html>